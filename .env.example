# PlaneSpotter environment. Author CKC. Version 0.1.0.
# BuildPack v1.8 section 2.3. Every variable is documented here.
# Secrets never enter the repo. Copy to .env and fill locally.

# Supabase, all apps
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase service role. Web server routes and Edge Functions only.
# Never bundled into a client. Never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox
MAPBOX_ACCESS_TOKEN=
MAPBOX_SECRET_TOKEN=

# Expo CI builds
EXPO_ACCESS_TOKEN=

# Error reporting
SENTRY_DSN_MOBILE=
SENTRY_DSN_WEB=

# Analytics, wrapped by packages/shared/events.ts. Raw EXIF, exact GPS,
# private media URLs, captions, emails and moderation notes never enter it.
POSTHOG_API_KEY=

# Comma separated list, gates the admin console
ADMIN_ALLOWED_EMAILS=

# Local only. Set to run the policy tests in tests/policy against a live
# Postgres. Unset means those tests skip and the Phase S gates stay unpassed.
DATABASE_URL=
