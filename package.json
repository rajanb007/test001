{
  "name": "planespotter",
  "version": "0.1.0",
  "private": true,
  "author": "CKC",
  "description": "PlaneSpotter monorepo. Phase S spike, see docs/PlaneSpotterBuildPack-v1.8.md section 9",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prefixes:generate": "tsx packages/shared/generate-prefix-migration.ts",
    "prefixes:check": "tsx scripts/check-prefix-drift.ts",
    "verify": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run prefixes:check && pnpm run tokens:check && pnpm run env:check && pnpm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:live": "bash scripts/test-live.sh",
    "tokens:generate": "tsx packages/shared/generate-tokens.ts",
    "tokens:check": "tsx scripts/check-token-drift.ts",
    "env:check": "tsx scripts/check-no-env-files.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "@planespotter/shared": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
